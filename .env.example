# Environment template for next-gen-portfolio
# Copy to .env.local for local dev. On Vercel, set the "Vercel project" vars listed below.

# ===============================================
# Vercel project — KEEP
# ===============================================

# Public Leo Worker URL (browser). Required for the widget to load.
NEXT_PUBLIC_LEO_WORKER_URL=https://voicebot.devmohan.in

# Canonical site URL for sitemap / robots. Keep (has code fallback to https://devmohan.in).
NEXT_PUBLIC_SITE_URL=https://devmohan.in

# CI Lighthouse only — set to "1" to serve a static audit homepage (no Motion/
# globe/Leo) and slim CSS. Do not set on Vercel production.
# NEXT_PUBLIC_SKIP_HEAVY_MEDIA=1

# GitHub token with read access to private mohansagark/portfolio-blog (prebuild fetch:blogs).
PORTFOLIO_BLOG_TOKEN=

# ===============================================
# Vercel project — ADD (contact form + Leo sync)
# ===============================================

# Cloudflare Turnstile (invisible captcha on /#contact). Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile — set widget mode to Invisible.
# Domains: localhost, 127.0.0.1, devmohan.in.
# Local/dev may fall back to Cloudflare always-pass test keys if unset.
# Production REQUIRES both NEXT_PUBLIC_TURNSTILE_SITE_KEY (build-time) and
# TURNSTILE_SECRET (runtime) — missing secret returns 503; missing sitekey
# does not embed the test key in the client bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Resend — transactional email for contact enquiries (required for /api/contact).
# https://resend.com/api-keys — verify a sending domain, then set FROM to that domain.
# Also set the verified From address + inbox in Vercel (and optionally .env.local):
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <contact@devmohan.in>
CONTACT_TO_EMAIL=contact@devmohan.in

# Cloudflare API token with Workers KV edit on the Leo namespace.
# Used by `npm run sync:leo` during `prebuild` on Vercel.
CLOUDFLARE_API_TOKEN=

# Optional — only if Wrangler cannot infer the account from the token.
# CLOUDFLARE_ACCOUNT_ID=

# Optional override — defaults to the production Leo PORTFOLIO_KV id.
# PORTFOLIO_KV_NAMESPACE_ID=0ac98a2a6f5f428aafa4dd9e1d3f2feb

# Optional — defaults to https://admin.devmohan.in (portfolio-data SoT on Vercel).
# PORTFOLIO_DATA_BASE_URL=https://admin.devmohan.in

# ===============================================
# Vercel project — DO NOT ADD (Leo Worker secrets)
# ===============================================
# GROQ_API_KEY, DEEPGRAM_API_KEY, OPENROUTER_API_KEY, etc.
# Those belong on the Cloudflare Leo Worker as secrets — not in Vercel.

# ===============================================
# Local-only / optional tooling (not required on Vercel)
# ===============================================
# PORTFOLIO_DATA_DIR=/Users/you/Documents/portfolio-data
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
