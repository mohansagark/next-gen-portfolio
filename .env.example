# 🌍 Environment Configuration Template
# Copy this file to .env.local and fill in your values

# ===============================================
# 🚀 VERCEL DEPLOYMENT SETTINGS
# ===============================================
# Get these from: https://vercel.com/account/tokens
# and your project settings

VERCEL_TOKEN=your_vercel_api_token_here
VERCEL_ORG_ID=your_organization_id_here
VERCEL_PROJECT_ID=your_project_id_here

# ===============================================
# 🌐 HOSTINGER FTP SETTINGS  
# ===============================================
# Get these from your Hostinger control panel
# File Manager → FTP Accounts

FTP_HOST=your_ftp_hostname_here
FTP_USERNAME=your_ftp_username_here  
FTP_PASSWORD=your_ftp_password_here

# ===============================================
# 🔧 BUILD CONFIGURATION
# ===============================================
# These control the build process

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ===============================================
# 🎯 DEPLOYMENT URLS
# ===============================================
# Update these with your actual URLs

STAGING_URL=https://your-project.vercel.app
PRODUCTION_URL=https://your-domain.com

# ===============================================
# 📊 ANALYTICS & MONITORING (Optional)
# ===============================================
# Add your analytics IDs if using

GOOGLE_ANALYTICS_ID=your_ga_id_here
VERCEL_ANALYTICS_ID=your_vercel_analytics_id_here

# ===============================================
# 🤖 LEO (AI VOICE BOT) WIDGET
# ===============================================
# The deployed ai-voice-bot Worker URL. Must be a NEXT_PUBLIC_ var (read client-side).

NEXT_PUBLIC_LEO_WORKER_URL=https://voicebot.devmohan.in

# ===============================================
# 🔐 SECURITY NOTES
# ===============================================
# 
# 1. NEVER commit this file to version control
# 2. Add .env.local to your .gitignore
# 3. Use GitHub Secrets for CI/CD
# 4. Rotate tokens regularly for security
# 5. Use environment-specific values
#
# ===============================================
