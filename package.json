    "glightbox": "^3.3.0",
    "gsap": "^3.12.7",
    "isotope-layout": "^3.0.6",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "^16.2.9",
    "nice-select2": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-globe.gl": "^2.38.0",
    "react-intersection-observer": "^9.16.0",
